DATASET_DIR=case_source/case_1/career_quest_dataset
DATABASE_PATH=.data/career-quest.sqlite
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
# Optional: used only on the server, when a person asks the assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Provider budget; the server caps this at 8500 ms to leave time for validation.
OPENAI_TIMEOUT_MS=8500
