{
  "name": "career-quest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib tests tailwind.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:http": "node tests/http.mjs",
    "test:ai": "node --import tsx tests/assistant-http.mjs",
    "test:reviews": "node --import tsx tests/reviews-http.mjs",
    "test:identity": "node --import tsx tests/identity-http.mjs",
    "demo": "npm ci && npm run build && AUTH_MODE=demo npm start"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "lucide-react": "^0.469.0",
    "next": "15.5.26",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.26",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2"
  }
}
